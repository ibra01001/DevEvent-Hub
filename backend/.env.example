# Example environment variables for production (DO NOT commit real secrets)
# Copy values into your deployment platform's env editor (Render, Netlify, etc.)

# App settings
# Render provides PORT automatically; you can omit this locally if Render sets it.
PORT=4000
NODE_ENV=production
FRONTEND_ORIGIN=https://your-frontend.netlify.app

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<dbUser>:<dbPassword>@<cluster>.mongodb.net/DevEventHub?retryWrites=true&w=majority

# Cloudinary (used for image uploads) — or replace with S3 settings if you prefer
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Security
JWT_SECRET=replace_with_a_strong_random_value

# Default account bootstrap (optional, used by seed script)
# Consider removing these after initial seeding or use a one-off seed run.
DEFAULT_ADMIN_NAME=Admin Name
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
DEFAULT_ADMIN_DEPARTMENT=Platform Administration

DEFAULT_STAFF_NAME=Staff Name
DEFAULT_STAFF_EMAIL=staff@example.com
DEFAULT_STAFF_PASSWORD=ChangeMe123!
DEFAULT_STAFF_DEPARTMENT=Technical Events

# Frontend config (set this on Netlify as VITE_API_BASE)
# Example: VITE_API_BASE=https://your-backend.onrender.com/api
# Frontend will call `${VITE_API_BASE}/events`, etc.

# Notes:
# - Never commit real secrets. Use your platform's environment editor.
# - Keep `JWT_SECRET` strong and rotate if compromised.
# - For initial seeding, run the seed script locally pointing to your production DB
#   or use a one-off Render shell command; remove bootstrap defaults afterwards.
