# Copy this file to `.env` and fill values for production/dev as needed
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Default account bootstrap: only created if the email does not already exist in MongoDB.
DEFAULT_ADMIN_NAME=your-full-name-admin
DEFAULT_ADMIN_EMAIL=your-email-admin
DEFAULT_ADMIN_PASSWORD=your-password-admin
DEFAULT_ADMIN_DEPARTMENT=Platform Administration

DEFAULT_STAFF_NAME=your-full-name-staff
DEFAULT_STAFF_EMAIL=your-email-staff
DEFAULT_STAFF_PASSWORD=your-password-staff
DEFAULT_STAFF_DEPARTMENT=Technical Events
